BOT_TOKEN=replace_me
ADMIN_IDS=123456789
# Production: postgresql+psycopg://sonarx:password@127.0.0.1:5432/sonarx
# Local development: leave DATABASE_URL empty to use SQLite.
DATABASE_URL=
DATABASE_PATH=data/sonarx.sqlite3
DB_POOL_SIZE=10
TIMEZONE=Asia/Tehran
PASARGUARD_VERIFY_TLS=true
FERNET_KEY=generate_with_python_cryptography
CURRENCY_LABEL=تومان
SUPPORT_USERNAME=
# Optional manual payment instructions (configured in bot settings)
# Docker Compose only: use a long random password
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Maintenance worker settings
ORDER_RECOVERY_MINUTES=15
SERVICE_SYNC_BATCH=500
